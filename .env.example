# Copy to .env and fill in the providers you use. Never commit .env.

# Groq free tier. The provider rotates to the next key automatically when one hits
# its DAILY token limit (see src/medsim/providers/openai_compat.py), so adding each
# group member's key multiplies the daily budget. GROQ_API_KEY_2 .. _9 are read.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

OPENAI_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
